# Скопируйте этот файл в .env и задайте свои значения.
# Файл .env не попадает в GitHub (он в .gitignore).

POSTGRES_USER=nedro
POSTGRES_PASSWORD=придумайте_пароль_для_базы
POSTGRES_DB=nedro

# Секрет для подписи токенов входа: любая длинная случайная строка (32+ символа)
JWT_SECRET=замените_на_длинную_случайную_строку

# Пароль, который получат тестовые пользователи при первом заполнении базы
SEED_PASSWORD=придумайте_пароль_для_входа
